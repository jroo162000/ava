{
  "voice": {
    "mode": "unified"
  },
  "voice_mode": "auto",
  "server_route": "respond",
  "audio": {
    "playback_rate": 44100,
    "output_device": null,
    "input_device": 1,
    "input_device_name": "Headset Microphone (Logitech H5)",
    "input_backend": "mme",
    "input_sample_rate": 44100,
    "input_channels": 1,
    "output_device_name": "Microsoft Sound Mapper - Output",
    "input_device_preferences": [
      "headset",
      "usb",
      "microphone"
    ],
    "input_device_avoid": [
      "microsoft sound mapper",
      "primary sound capture driver",
      "stereo mix",
      "what u hear",
      "loopback",
      "webcam",
      "c920e"
    ],
    "max_idle_rms": 1000,
    "min_live_rms": 20,
    "calibration": {
      "state_path": "logs/voice_calibration.json",
      "prefer_saved_pair": true
    },
    "loopback_probe": {
      "enabled": false,
      "validation_only": true,
      "input_only": true,
      "top_candidates": 4,
      "tone_hz": 880.0,
      "tone_ms": 180,
      "amplitude": 18000,
      "pre_roll_sec": 0.1,
      "post_roll_sec": 0.25,
      "min_peak_rms": 1200,
      "cooldown_sec": 0.08,
      "mode": "speech",
      "speech_text": "Hey Ava say hello there",
      "speech_match_min": 0.45,
      "speech_calibration_min": 0.6,
      "require_speech_calibration": true,
      "allow_failed_calibration_fallback": false,
      "fail_closed_without_calibration": false,
      "speech_model": "tiny.en",
      "speech_frame_ms": 20
    },
    "input_device_blocklist": [
      "webcam",
      "c920e"
    ]
  },
  "vad": {
    "start_rms": 60,
    "stop_rms": 45,
    "hold_sec": 1.2,
    "dyn_thresh_scale": 1.0
  },
  "local_fallback": {
    "tts_engine": "piper",
    "edge_voice": "en-US-MichelleNeural",
    "whisper_model": "tiny.en",
    "auto_switch": true,
    "force_local": true,
    "piper": {
      "exe": "C:/Users/USER 1/ava/ava-integration/vendor/piper/piper.exe",
      "model": "C:/Users/USER 1/ava/ava-integration/vendor/piper/models/ava_vella.onnx"
    }
  },
  "elevenlabs": {
    "enabled": true,
    "voice_id": "C87xFko6mfAf2uYY3Rdr",
    "api_key_env": "ELEVENLABS_API_KEY",
    "model_id": "eleven_flash_v2_5",
    "output_format": "pcm_24000",
    "stability": 0.5,
    "similarity_boost": 0.75,
    "style": 0.0,
    "comment": "PRIMARY voice = 'Vella' instant clone (ElevenLabs). Used first when the ELEVENLABS_API_KEY env var is set; the offline fallback is now the locally-trained Piper 'Vella' (ava_vella.onnx, 295-epoch fine-tune). voice_id from the ElevenLabs dashboard."
  },
  "asr": {
    "utterance": {
      "max_utterance_sec": 300,
      "end_silence_ms": 1500,
      "min_speech_ms": 250,
      "comment": "max_utterance_sec is a safety cap only; your turn ends naturally when you stop talking for end_silence_ms. Raised so the mic does not cut you off mid-sentence."
    },
    "early_commit": {
      "enabled": true,
      "stable_time_sec": 0.5,
      "max_words": 3,
      "comment": "Conservative early commit to reduce false activations from Vosk partials"
    }
  },
  "intent_routing": {
    "enabled": true,
    "local_patterns": [
      "pause automation",
      "resume automation",
      "stop automation",
      "create file",
      "remember that",
      "send email",
      "turn on",
      "turn off",
      "system info",
      "camera"
    ]
  },
  "safety": {
    "confirm_destructive": true,
    "destructive_keywords": [
      "delete",
      "remove",
      "format",
      "restart",
      "shutdown",
      "send",
      "kill",
      "terminate"
    ]
  },
  "echo_cancellation": {
    "enabled": true,
    "suppress_tts_during_mic": true,
    "grace_period_sec": 3.0,
    "tts_cooldown_sec": 2.5,
    "rms_boost_during_tts": 2.0
  },
  "voice_stabilization": {
    "final_only_gating": true,
    "half_duplex": true,
    "turn_state_logging": true,
    "comment": "Partials display only, finals trigger DECIDE. Mic muted during SPEAK state."
  },
  "barge_in": {
    "enabled": false,
    "min_speech_ms": 500,
    "require_final_to_interrupt": true,
    "cancel_tts_on_interrupt": true,
    "cooldown_after_interrupt_ms": 1000,
    "comment": "D005: Barge-in disabled by default. When enabled, user can interrupt TTS with speech. Requires final transcript to trigger interrupt (not partials)."
  },
  "safe_mode": {
    "enabled": false,
    "disable_barge_in": true,
    "disable_realtime_asr": false,
    "fallback_tts_engine": "piper",
    "comment": "Safe mode disables fragile features after repeated crashes. Auto-enabled by crash supervisor."
  },
  "crash_supervision": {
    "enabled": true,
    "max_restarts": 5,
    "restart_window_sec": 300,
    "initial_backoff_sec": 3,
    "max_backoff_sec": 60,
    "safe_mode_after_crashes": 3,
    "crash_report_dir": "logs/crash_reports",
    "state_file": "logs/runner_state.json",
    "comment": "Supervisor settings for crash containment and recovery."
  },
  "validation_mode": {
    "enabled": true,
    "wake_words": [
      "hey ava",
      "hey eva",
      "ok ava",
      "ava",
      "eva",
      "hey able",
      "aber"
    ],
    "min_words_without_wake": 3,
    "blocked_tools": [
      "camera_ops",
      "proactive_suggest"
    ],
    "force_half_duplex": true,
    "disable_proactive": true,
    "disable_passive_learning": true,
    "require_wake_for_tools": true,
    "followup_window_sec": 6.0,
    "comment": "Validation mode for human testing - requires wake word, disables autonomy."
  }
}
